{
    "version": 2,
    "builds": [
        {
            "src": "src/server.js",
            "use": "@vercel/node"
        }
    ],
    "routes": [
        {
            "src": "/(.*)",
            "dest": "/src/server.js",
        }
    ],
    "env": {
        "MONGO_URI": "${MONGO_URI}",
        "ARCJET_KEY": "${ARCJET_KEY}",
        "CLERK_SECRET_KEY": "${CLERK_SECRET_KEY}",
        "CLERK_PUBLISHABLE_KEY": "${CLERK_PUBLISHABLE_KEY}",
        "PORT": "${PORT}",
        "NODE_ENV": "production"
    }
}